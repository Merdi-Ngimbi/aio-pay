# ============================================================
# AIO PAY - Variables d'environnement (Backend)
# ============================================================
# Copie ce fichier en .env et remplis les valeurs
# ============================================================

# Port de l'API (ne pas mettre 3000, c'est pour le frontend)
PORT=3001

# Clé secrète pour signer les tokens JWT
# CHANGE CETTE VALEUR EN PRODUCTION !
JWT_SECRET=aio-pay-dev-secret-change-me-in-production

# FlexPay (à remplir quand tu auras les credentials sandbox)
FLEXPAY_API_URL=https://backend.flexpay.cd/api
FLEXPAY_API_KEY=
FLEXPAY_WEBHOOK_SECRET=

# SMS Gateway (optionnel pour le MVP)
SMS_PROVIDER=console
SMS_API_KEY=
